{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lab-studio.local/schemas/studio.resource-run-context/1.0",
  "title": "Studio Resource Run Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "participants", "grouping", "sections", "repeats", "technicalReplicates", "stations", "availableInventory", "instrumentCapacities"],
  "properties": {
    "requestId": { "$ref": "#/definitions/nonEmptyString" },
    "participants": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "grouping": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "groupSize"],
          "properties": {
            "kind": { "const": "group-size" },
            "groupSize": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "groups"],
          "properties": {
            "kind": { "const": "explicit" },
            "groups": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "participantCount"],
                "properties": {
                  "id": { "$ref": "#/definitions/nonEmptyString" },
                  "participantCount": { "type": "integer", "minimum": 1 },
                  "sectionId": { "$ref": "#/definitions/nonEmptyString" }
                }
              }
            }
          }
        }
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "participantCount"],
        "properties": {
          "id": { "$ref": "#/definitions/nonEmptyString" },
          "participantCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "repeats": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "technicalReplicates": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "stations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/definitions/nonEmptyString" },
          "label": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "availableInventory": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "quantity"],
        "properties": {
          "resourceId": { "$ref": "#/definitions/nonEmptyString" },
          "quantity": { "$ref": "#/definitions/quantity" }
        }
      }
    },
    "instrumentCapacities": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "unitsAvailable"],
        "properties": {
          "resourceId": { "$ref": "#/definitions/nonEmptyString" },
          "unitsAvailable": { "type": "integer", "minimum": 1 },
          "groupsPerUnitPerWave": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "preparationWindow": { "$ref": "#/definitions/planningWindow" },
    "runWindow": { "$ref": "#/definitions/planningWindow" },
    "cleanupWindow": { "$ref": "#/definitions/planningWindow" }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "decimalString": { "type": "string", "pattern": "^[+-]?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
    "controlledUnit": { "enum": ["1", "%", "s", "min", "h", "uL", "mL", "L", "ug", "mg", "g", "kg", "umol", "mmol", "mol", "uM", "mM", "M", "degC", "K", "rpm", "nm", "AU", "OD", "pH"] },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "$ref": "#/definitions/decimalString" },
        "unit": { "$ref": "#/definitions/controlledUnit" }
      }
    },
    "planningWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration"],
      "properties": {
        "start": { "$ref": "#/definitions/nonEmptyString" },
        "duration": { "$ref": "#/definitions/quantity" }
      }
    }
  }
}
