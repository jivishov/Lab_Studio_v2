{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lab-studio.local/schemas/studio.domain-pack-descriptor/1.0",
  "title": "Studio Domain Pack Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "artifactKinds", "supportedProcedureIRVersions", "minimumStudioCoreVersion", "publicNamespaces", "limitations"],
  "properties": {
    "id": { "enum": ["chemistry", "assay"] },
    "version": { "$ref": "#/definitions/version" },
    "title": { "$ref": "#/definitions/nonEmptyString" },
    "artifactKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "supportedProcedureIRVersions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" } },
    "minimumStudioCoreVersion": { "$ref": "#/definitions/version" },
    "publicNamespaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "limitations": { "type": "array", "items": { "$ref": "#/definitions/nonEmptyString" } }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
  }
}
